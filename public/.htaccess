# ------------------------------------------------------
# LITESPEED CACHE HEADERS
# ------------------------------------------------------
<IfModule mod_headers.c>
    # For JS and CSS files
    <FilesMatch "\.(js|css)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # For fonts
    <FilesMatch "\.(woff2?|ttf|otf|eot)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # For images
    <FilesMatch "\.(png|jpe?g|webp|avif|svg|gif|ico)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # For audio/video
    <FilesMatch "\.(mp3|mp4|webm)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------
# SECURITY HEADERS
# ------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------------------------------
# REWRITE RULES
# ------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve static assets directly (bypass Laravel)
    RewriteCond %{REQUEST_URI} ^/build/ [OR]
    RewriteCond %{REQUEST_URI} ^/assets/ [OR]
    RewriteCond %{REQUEST_URI} ^/images/ [OR]
    RewriteCond %{REQUEST_URI} ^/sound/
    RewriteRule ^ - [L,E=CACHE_CONTROL:max-age=31536000]

    # Force HTTPS + www — use 308 for API routes to preserve POST/PUT/DELETE methods
    #
    # %1 refers to the LAST RewriteCond in the chain, so the host-capturing
    # condition must come last — putting the /api/ check after it (as this
    # used to) made %1 resolve against "^/api/" instead, which has no capture
    # group, so %1 came out empty and every API request got redirected to
    # the broken "https://www./..." (missing hostname).
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteRule ^(.*)$ https://www.%1/$1 [L,R=308]

    # Force HTTPS + www for all other routes (301 is fine for browser navigation)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteRule ^(.*)$ https://www.%1/$1 [L,R=301]

    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Remove trailing slash
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Laravel Front Controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Set environment variables for LiteSpeed
<IfModule mod_env.c>
    SetEnv CACHE-CONTROL "public, max-age=31536000, immutable"
</IfModule>
